msgstr "lista de elementos relacionados con breves descripciones"

#: 599f4026de37441bb0ec5d2f201e1c13
msgid "`Notes` [*optional*]: additional information or clarifications"
msgstr "`Notes` [*opcional*]: información adicional o aclaraciones"

#: 71fa7381e2e1426ab8edec35e9087705
msgid "for implementation details or caveats"
msgstr "para obtener detalles sobre la implementación o advertencias"

#: 28032a8f98854bfeb4b716cde83cd8aa
msgid "User experience conventions"
msgstr "Convenciones de experiencia de usuario"

#: 0922707d3bf940c1adebe9da478fed96
