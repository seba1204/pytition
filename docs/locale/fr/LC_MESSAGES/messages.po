msgstr "Sections docstring NumPy"

#: 5e4ab1304a2445fc96fb229fe7479bc8
msgid ""
"def add(a: int, b: int) -> int:\n"
"    \"\"\"\n"
"    Add two integers.\n"
"\n"
"    Parameters\n"
"    ----------\n"
"    a : int\n"
"        The first integer.\n"
"    b : int\n"
"        The integers to add.\n"
"    Returns\n"
"    -------\n"
"    int\n"
"        The sum of the two integers.\n"
"    \"\"\"\n"
"    return a + b\n"
msgstr ""
"def add(a: int, b: int) -> int:\n"
"    \"\"\"\n"
"    Add two integers.\n"
"\n"
"    Parameters\n"
"    ----------\n"
"    a : int\n"
"        The first integer.\n"
"    b : int\n"
"        The integers to add.\n"
"    Returns\n"
"    -------\n"
"    int\n"
"        The sum of the two integers.\n"
"    \"\"\"\n"
"    return a + b\n"

