#: 32b760e06b2e48ac939372ff8a7562b6
msgid "Comments and docstrings"
msgstr "Commentaires et chaînes de documentation"

#: 79026bc6a4ab4e0c9b56d4dc3b16004f
msgid "Write docstrings for all public modules, functions, classes, and methods."
msgstr ""
"Écrire des docstrings pour tous les modules, fonctions, classes et méthodes "
