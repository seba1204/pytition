@startuml "modern-dark"

' --- Primary colors ---
skinparam BackgroundColor #1E1E1E
skinparam DefaultFontColor #E5E7EB
skinparam Shadowing false

' --- Typography ---
skinparam DefaultFontName "Inter, Segoe UI, Roboto, Helvetica, Arial"
skinparam DefaultFontSize 14
skinparam ArrowFontSize 13
skinparam ParticipantFontSize 13
skinparam ActivityFontSize 13

' --- Lines & connectors ---
skinparam ArrowColor #9CA3AF
skinparam ArrowThickness 1.3
skinparam LineColor #4B5563
skinparam BorderColor #4B5563

' --- Boxes, actors, etc. ---
skinparam RectangleBackgroundColor #2D2D2D
skinparam RectangleBorderColor #4B5563
skinparam RectangleFontColor #F3F4F6
skinparam ActorBorderColor #6B7280
skinparam ActorBackgroundColor #1F2937
skinparam ActorFontColor #F9FAFB
skinparam ComponentBackgroundColor #2D2D2D
skinparam ComponentBorderColor #4B5563

' --- Notes / captions ---
skinparam NoteBackgroundColor #374151
skinparam NoteBorderColor #4B5563
skinparam NoteFontColor #F3F4F6

' --- Activities / Sequences ---
skinparam SequenceLifeLineBorderColor #4B5563
skinparam SequenceLifeLineBackgroundColor #374151
skinparam SequenceParticipantBackgroundColor #1F2937
skinparam SequenceParticipantBorderColor #4B5563
skinparam SequenceBoxBackgroundColor #2D2D2D
skinparam SequenceBoxBorderColor #4B5563

' --- Miscellaneous ---
skinparam ActivityStartColor #10B981
skinparam ActivityEndColor #F87171
skinparam PackageBackgroundColor #2D2D2D
skinparam PackageBorderColor #4B5563

' --- Font settings for specific elements ---
skinparam NodeFontName "Inter, Segoe UI, Roboto, Helvetica, Arial"
skinparam NodeFontSize 13
skinparam DatabaseFontName "Inter, Segoe UI, Roboto, Helvetica, Arial"
skinparam DatabaseFontSize 13

' --- Specific element colors ---
skinparam NodeBackgroundColor #2D2D2D
skinparam NodeBorderColor #4B5563
skinparam NodeFontColor #E5E7EB

skinparam DatabaseBackgroundColor #2D2D2D
skinparam DatabaseBorderColor #4B5563
skinparam DatabaseFontColor #E5E7EB

skinparam NodeBackgroundColor<<entrypoint>> #09312A
skinparam NodeBorderColor<<entrypoint>>     #10B981

skinparam DatabaseBackgroundColor<<config>> #2C2411
skinparam DatabaseBorderColor<<config>>     #D97706
skinparam DatabaseFontColor<<config>>       #FDE68A

skinparam RectangleBackgroundColor #2A2A2A
skinparam RectangleBorderColor #3F3F46


' --- Shape styling ---

skinparam RoundCorner 15
skinparam RectangleRoundCorner 15
skinparam NodeRoundCorner 15
skinparam PackageRoundCorner 12
skinparam FrameRoundCorner 12
skinparam DatabaseRoundCorner 15
skinparam CloudRoundCorner 15
skinparam ArtifactRoundCorner 15
skinparam CardRoundCorner 15
skinparam NoteRoundCorner 8

skinparam RectanglePadding 8
skinparam NodePadding 8
skinparam PackagePadding 6
skinparam DatabasePadding 6
skinparam NotePadding 6

skinparam Shadowing false
skinparam Shadowing true
skinparam ShadowColor #111827
skinparam ShadowThickness 1

@enduml
