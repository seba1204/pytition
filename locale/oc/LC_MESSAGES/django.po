msgstr "S’avètz pas de verai compte mail, daissatz « localhost »."

#: src/apps/petitions/admin.py:115 src/apps/presets/admin.py:114
msgid ""
"25 for cleartext connection, 587 for STARTTLS, 465 for TLS. Prefer TLS if "
"the email server supports it."
msgstr ""
"25 per una connexion en clar (pas chifrada), 587 per STARTRLS, 465 per TLS. "
"Preferir TLS se lo servidor es compatible."

