msgstr "Цвет назначения для линейного градиента"

#: src/apps/petitions/admin.py:149 src/apps/presets/admin.py:148
msgid "Color for monochrome background color"
msgstr "Цвет для монохромного фона"

#: src/apps/petitions/admin.py:150 src/apps/presets/admin.py:149
msgid "Footer text"
msgstr "Текст в нижнем колонтитуле"

#: src/apps/petitions/admin.py:151 src/apps/presets/admin.py:150
