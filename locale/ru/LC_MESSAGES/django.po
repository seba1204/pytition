msgstr "Количество подписей на бумаге (или другом внешнем носителе)"

#: src/apps/petitions/admin.py:142 src/apps/presets/admin.py:141
msgid "Enable paper signatures accounting"
msgstr "Включить учет бумажных подписей"

#: src/apps/petitions/admin.py:145 src/apps/presets/admin.py:144
msgid "Direction of linear gradient for background color"
msgstr "Направление линейного градиента для цвета фона"

#: src/apps/petitions/admin.py:147 src/apps/presets/admin.py:146
